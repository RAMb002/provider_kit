{
    "ViewStateWidgetsProvider": {
        "prefix": "pkViewStateWidgetsProvider",
        "description": "Configure default widgets for ProviderKit ViewStates.",
        "body": [
            "ViewStateWidgetsProvider(",
            "  initialStateBuilder: (context, isSliver) => ${1:initialWidget},",
            "  loadingStateBuilder: (context, details, isSliver) => ${2:loadingWidget},",
            "  errorStateBuilder: (context, details, isSliver) => ${3:errorWidget},",
            "  emptyStateBuilder: (context, details, isSliver) => ${4:emptyWidget},",
            "  child: ${5:child},",
            ")$0"
        ]
    }
}